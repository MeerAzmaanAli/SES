{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https:;"
        }
      ]
    },
    {
      "source": "/.well-known/ard.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(public/.*|.*\\.(?:ico|png|jpg|jpeg|svg|webp|css|js|woff2?))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/services/(?i)hvac/?",
      "destination": "/services/hvac/",
      "permanent": true
    },
    {
      "source": "/services/(?i)fire-fighting/?",
      "destination": "/services/fire-fighting/",
      "permanent": true
    },
    {
      "source": "/services/(?i)cold-rooms/?",
      "destination": "/services/cold-rooms/",
      "permanent": true
    },
    {
      "source": "/services/(?i)electrical/?",
      "destination": "/services/electrical/",
      "permanent": true
    },
    {
      "source": "/blog/(?i)hvac/?",
      "destination": "/blog/hvac/",
      "permanent": true
    },
    {
      "source": "/blog/(?i)fire-safety/?",
      "destination": "/blog/fire-safety/",
      "permanent": true
    },
    {
      "source": "/blog/(?i)cold-chain/?",
      "destination": "/blog/cold-chain/",
      "permanent": true
    },
    {
      "source": "/blog/(?i)what-is-mep-engineering/?",
      "destination": "/blog/what-is-mep-engineering/",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/services/", "destination": "/services/index.html" },
    { "source": "/services/(?i)fire-fighting/", "destination": "/services/fire-fighting/index.html" },
    { "source": "/services/(?i)hvac/", "destination": "/services/hvac/index.html" },
    { "source": "/services/(?i)cold-rooms/", "destination": "/services/cold-rooms/index.html" },
    { "source": "/services/(?i)electrical/", "destination": "/services/electrical/index.html" },
    { "source": "/projects/", "destination": "/projects/index.html" },
    { "source": "/project/", "destination": "/project/index.html" },
    { "source": "/about/", "destination": "/about/index.html" },
    { "source": "/team/", "destination": "/team/index.html" },
    { "source": "/clients/", "destination": "/clients/index.html" },
    { "source": "/contact/", "destination": "/contact/index.html" },
    { "source": "/blog/", "destination": "/blog/index.html" },
    { "source": "/blog/(?i)what-is-mep-engineering/", "destination": "/blog/what-is-mep-engineering/index.html" },
    { "source": "/blog/(?i)fire-safety/", "destination": "/blog/fire-safety/index.html" },
    { "source": "/blog/(?i)hvac/", "destination": "/blog/hvac/index.html" },
    { "source": "/blog/(?i)cold-chain/", "destination": "/blog/cold-chain/index.html" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/llms.txt", "destination": "/llms.txt" },
    { "source": "/.well-known/ard.json", "destination": "/.well-known/ard.json" },
    { "source": "/(.*)", "destination": "/error/index.html" }
  ]
}
