{
  "trailingSlash": true,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/about/", "destination": "/about.html" },
    { "source": "/services/", "destination": "/services.html" },
    { "source": "/projects/", "destination": "/projects.html" },
    { "source": "/clients/", "destination": "/clients.html" },
    { "source": "/team/", "destination": "/team.html" },
    { "source": "/blog/", "destination": "/blog.html" },
    { "source": "/contact/", "destination": "/contact.html" },
    { "source": "/project/", "destination": "/project.html" },
    { "source": "/error/", "destination": "/error.html" },
    { "source": "/blog/fire-safety/", "destination": "/blog-fire-safety.html" },
    { "source": "/blog/hvac/", "destination": "/blog-hvac.html" },
    { "source": "/blog/cold-chain/", "destination": "/blog-cold-chain.html" },
    { "source": "/(.*)", "destination": "/error.html" }
  ]
